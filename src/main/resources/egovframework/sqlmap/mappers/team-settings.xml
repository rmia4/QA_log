<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.team.mapper.TeamSettingsMapper">

    <select id="selectInviteCodeHash" resultType="string">
        SELECT invite_code_hash
        FROM team_settings
        ORDER BY id DESC
        LIMIT 1
    </select>

</mapper>
