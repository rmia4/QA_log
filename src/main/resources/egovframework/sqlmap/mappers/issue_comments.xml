<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.issue.mapper.IssueCommentMapper">

    <insert id="insertComment" parameterType="egovframework.issue.vo.IssueCommentVO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO issue_comments (issue_id, content, created_by)
        VALUES (#{issueId}, #{content}, #{createdBy})
    </insert>

    <resultMap id="issueCommentResultMap" type="egovframework.issue.dto.IssueCommentResponseDTO">
        <id     column="id"          property="id" />
        <result column="content"     property="content" />
        <result column="created_by"  property="createdBy" />
        <result column="author_name" property="authorName" />
        <result column="created_at"  property="createdAt" />
    </resultMap>

    <select id="selectComments" parameterType="long" resultMap="issueCommentResultMap">
        SELECT c.id, c.content, c.created_by, u.display_name AS author_name, c.created_at
        FROM issue_comments c
        JOIN users u ON u.id = c.created_by
        WHERE c.issue_id = #{issueId}
        ORDER BY c.created_at ASC, c.id ASC
    </select>

</mapper>
